rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Customer Feedback Collection
    match /feedback/{feedbackId} {
      
      // 1. Allow public read ONLY for approved customer feedback
      allow read: if resource.data.approved == true;

      // 2. Allow public create with strict validation
      allow create: if request.resource.data.approved == false
                    && request.resource.data.rating is int
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 60
                    && request.resource.data.comment is string
                    && request.resource.data.comment.size() > 0
                    && request.resource.data.comment.size() <= 500
                    && (
                      !('area' in request.resource.data) ||
                      (request.resource.data.area is string && request.resource.data.area.size() <= 60)
                    )
                    && request.resource.data.createdAt == request.time;

      // 3. Deny all public update and delete (only admin via Firebase Console can edit/approve)
      allow update, delete: if false;
    }
    
    // Deny access to any other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
